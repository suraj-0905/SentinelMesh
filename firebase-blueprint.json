{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, email, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["Security Admin", "SecOps Analyst", "AI Engineer", "Auditor", "admin", "security_analyst", "developer", "auditor"] },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Agent": {
      "title": "Agent",
      "description": "Registered AI Agent configuration and security parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "role": { "type": "string" },
        "trustScore": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended", "revoked"] },
        "rateLimitPerMin": { "type": "number" },
        "assignedPolicyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "SecurityPolicy": {
      "title": "SecurityPolicy",
      "description": "Firewall policy rules defining allowed tools and constraints",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "allowOutboundTransfer": { "type": "boolean" },
        "maxArgumentLength": { "type": "number" },
        "riskThreshold": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "enabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "enabled"]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Firewall decision telemetry log for tool call validation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "requestId": { "type": "string" },
        "agentId": { "type": "string" },
        "toolName": { "type": "string" },
        "decision": { "type": "string", "enum": ["ALLOW", "BLOCK"] },
        "reason": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "isSimulation": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "agentId", "toolName", "decision"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Security incident alert generated by firewall violations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "INVESTIGATING", "RESOLVED"] },
        "remediation": { "type": "string" },
        "affectedAgentId": { "type": "string" }
      },
      "required": ["id", "timestamp", "severity", "title", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles storing credentials, identity, and preferences"
    },
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "Registered AI agent profiles and firewall statuses"
    },
    "/policies/{policyId}": {
      "schema": "SecurityPolicy",
      "description": "Firewall enforcement policies and rulesets"
    },
    "/audit_events/{eventId}": {
      "schema": "AuditEvent",
      "description": "Immutable telemetry and evaluation events"
    },
    "/alerts/{alertId}": {
      "schema": "SecurityAlert",
      "description": "Active and resolved security alerts"
    }
  }
}
